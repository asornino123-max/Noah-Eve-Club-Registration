PORT=4180
HOST=127.0.0.1
ADMIN_TOKEN=local-dev

# Production storage. When both values are present, the API uses Supabase instead
# of local JSON files.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_REGISTRATIONS_TABLE=registrations
SUPABASE_OUTBOX_TABLE=email_outbox

# Local fallback mode writes email payloads to data/email-outbox.json.
# For production on Vercel, set RESEND_API_KEY and verified sender details.
RESEND_API_KEY=
EMAIL_FROM=Noah & Eve Center <members@yourdomain.com>
TEAM_NOTIFY_EMAIL=
BOOKING_URL=https://www.instagram.com/noahandeveclub/
